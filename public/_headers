# Encabezados de Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Solo esta app puede pedir la ubicación; cámara y micrófono nunca.
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  X-Frame-Options: DENY
  # El mapa base y sus tipografías se sirven desde este mismo sitio ('self').
  # Orígenes externos: clima y aire (Open-Meteo), rutas (OSRM de FOSSGIS) y el Worker de
  # ocupación (*.workers.dev). Si el Worker usa otro dominio, agrégalo a connect-src.
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.open-meteo.com https://air-quality-api.open-meteo.com https://routing.openstreetmap.de https://*.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Archivos con hash en el nombre: nunca cambian.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker y el manifest deben revisarse en cada visita.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Mapa base: el nombre no lleva hash, pero la app lo pide con ?v=<build>.
/mapa/*
  Cache-Control: public, max-age=86400
